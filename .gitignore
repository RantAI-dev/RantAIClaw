/target
firmware/*/target
*.db
*.db-journal
.DS_Store
._*
.wt-pr37/
__pycache__/
*.pyc
docker-compose.override.yml

# Local scratch logs & temp probe files (never source)
*.log
.tmp*

# Environment files (may contain secrets)
.env

# Python virtual environments

.venv/
venv/

