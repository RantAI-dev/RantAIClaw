.embuild/
.env.local
.env.*.local

# Secret keys and credentials
.secret_key
*.key
*.pem
credentials.json
.worktrees/

# Local Claude Code harness state
.claude/
# Anchored to the repo root: unanchored, `memory/` also matches `src/memory/`,
# so any new source file added there is silently ignored. The tracked ones
# predate the rule and are unaffected, which is what hid it.
/memory/
state/

# Agent implementation plans & specs (scratchpad — not product docs)
docs/superpowers/plans/
docs/superpowers/specs/

# Agent scratchpads. These are working notes, not product docs, and several of
# them name security holes before those holes are fixed — so a stray
# `git add -A` publishes them to a public AGPL repository. That is not
# hypothetical: `plans/` was committed once already, on a branch that reached
# `origin` and carried 283 of these files until 2026-09-07.
#
# `.superpowers/sdd/` self-ignored via its own nested `.gitignore`, which left
# any *new* subdirectory uncovered; the rule belongs here instead.
plans/
.agents/
.codegraph/
.rtk/
.superpowers/

# Runtime lockfile written beside the binary, not source.
skills-lock.json

# Local product experiments live as separate repos and are not pushed here.
product/

# CI-only build context (downloaded by pub-release.yml; not source)
artifacts/

# Locally cloned RantAIClaw-Site (separate repo, never committed here)
/site/

# KB extractor PDF test fixtures — generated on demand by
# tests/kb/extract_test.rs (build_pdf helper) so binary blobs don't
# enter source control.
tests/fixtures/sample-text.pdf
tests/fixtures/sample-8-page.pdf
dev-sandbox/

# Per-developer agent-harness configuration. `docs/agents/` holds the issue-tracker,
# triage-label and domain-doc conventions the mattpocock/skills set reads; both it and
# `CLAUDE.local.md` describe one person's local tooling, so they stay out of the repo
# for the same reason the OpenCode/Gemini/CodeRabbit configs were removed.
docs/agents/
CLAUDE.local.md
