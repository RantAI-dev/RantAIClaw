index 6864288..ba084cf 100644
--- a/src/memory/sqlite.rs
+++ b/src/memory/sqlite.rs
@@ -2743,4 +2743,44 @@ mod tests {
 
         assert_eq!(mem.count().await.unwrap(), 1);
     }
+
+    // ── temporary probes (not for merge) ───────────────────────────
+
+    /// `memory stats` prints `Total` from `count()` and the by-category
+    /// breakdown from `list()`. If `list()` is capped they disagree.
+    #[tokio::test]
+    async fn probe_list_len_matches_count_past_the_cap() {
+        let (_tmp, mem) = temp_sqlite();
+        for i in 0..1100 {
+            mem.store(&format!("k{i}"), "filler", MemoryCategory::Core, None)
+                .await
+                .unwrap();
+        }
+
+        let total = mem.count().await.unwrap();
+        assert_eq!(total, 1100, "control: count() sees every row");
+
+        let listed = mem.list(None, None).await.unwrap().len();
+        assert_eq!(
+            listed, total,
+            "stats breakdown is built from list(), which returned {listed} of {total}"
+        );
+    }
+
+    /// Control for `probe_forget_across_two_files` in the markdown backend:
+    /// the same two writes under sqlite leave one row, and forget clears it.
+    #[tokio::test]
+    async fn probe_forget_across_two_categories() {
+        let (_tmp, mem) = temp_sqlite();
+        mem.store("dupe", "core copy", MemoryCategory::Core, None)
+            .await
+            .unwrap();
+        mem.store("dupe", "daily copy", MemoryCategory::Daily, None)
+            .await
+            .unwrap();
+
+        assert_eq!(mem.count().await.unwrap(), 1, "control: upsert, not append");
+        assert!(mem.forget("dupe").await.unwrap());
+        assert!(mem.get("dupe").await.unwrap().is_none());
+    }
 }
