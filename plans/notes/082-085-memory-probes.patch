+
+    // ── temporary probes (not for merge) ───────────────────────────
+
+    /// `memory stats` renders `Total` from `count().unwrap_or(0)` and `Health`
+    /// from `health_check()`. If those two can disagree, `Total: 0` is printed
+    /// for a store that is neither empty nor readable.
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn probe_count_failure_is_visible_next_to_health() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let (_tmp, mem) = temp_workspace();
+        mem.store("a", "readable", MemoryCategory::Daily, None)
+            .await
+            .unwrap();
+        assert_eq!(mem.count().await.unwrap(), 1, "control: it counts");
+
+        let daily = mem.daily_path();
+        std::fs::set_permissions(&daily, std::fs::Permissions::from_mode(0o000)).unwrap();
+
+        let counted = mem.count().await;
+        let healthy = mem.health_check().await;
+        std::fs::set_permissions(&daily, std::fs::Permissions::from_mode(0o644)).unwrap();
+
+        assert!(counted.is_err(), "control: an unreadable file fails count()");
+        assert!(
+            !healthy,
+            "count() failed but health_check() still says healthy, so stats prints \
+             `Total: 0` + `Health: healthy` for an unreadable store"
+        );
+    }
+
+    #[tokio::test]
+    async fn probe_forget_across_two_files() {
+        let (_tmp, mem) = temp_workspace();
+        mem.store("dupe", "core copy", MemoryCategory::Core, None)
+            .await
+            .unwrap();
+        mem.store("dupe", "daily copy", MemoryCategory::Daily, None)
+            .await
+            .unwrap();
+
+        let removed = mem.forget("dupe").await.unwrap();
+        assert!(removed, "control: forget reports it removed something");
+
+        let leftover = mem.get("dupe").await.unwrap();
+        assert!(
+            leftover.is_none(),
+            "forget returned true but entry survives: {leftover:?}"
+        );
+    }
+
+    #[tokio::test]
+    async fn probe_store_same_key_twice_is_upsert() {
+        let (_tmp, mem) = temp_workspace();
+        mem.store("k", "old value", MemoryCategory::Core, None)
+            .await
+            .unwrap();
+        mem.store("k", "new value", MemoryCategory::Core, None)
+            .await
+            .unwrap();
+
+        let count = mem.count().await.unwrap();
+        assert_eq!(count, 1, "one key must count once");
+
+        let rows: Vec<_> = mem
+            .list(None, None)
+            .await
+            .unwrap()
+            .into_iter()
+            .filter(|e| e.key == "k")
+            .collect();
+        assert_eq!(rows.len(), 1, "stale row survives: {rows:?}");
+    }
 }
